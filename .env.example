# Autologic — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in the real values.
# NEVER commit the filled-in file — this repository is PUBLIC. Only this
# template (no real secrets) is committed.
#
# On Vercel these live in Settings → Environment Variables instead of a file.
# On a VPS, put them all in one `.env` next to the app; Next.js loads it
# automatically (or your process manager / Docker passes it in).
#
# Legend:  [required] the app breaks without it   ·   [optional] a feature is
# off until it is set.  Variables beginning NEXT_PUBLIC_ are sent to the
# BROWSER — never put a secret in one of those.
# ---------------------------------------------------------------------------

# ── Site ────────────────────────────────────────────────────────────────────
# The public URL of this deployment. Used in OAuth redirects and emails.
SITE_URL=https://your-domain.com                 # [required]
NEXT_PUBLIC_SITE_URL=https://your-domain.com      # [required] browser-visible copy

# ── Supabase (database) ─────────────────────────────────────────────────────
# Project URL and the SERVICE key (server-side, full access — keep secret).
SUPABASE_URL=https://xxxx.supabase.co             # [required]
SUPABASE_SERVICE_KEY=                             # [required] service_role key — SECRET
# Browser-visible Supabase values, used by the client for auth.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co # [required]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=             # [required] the publishable/anon key
# Optional alias some hosts use for the service key; SUPABASE_SERVICE_KEY is preferred.
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Google Gemini — the platform key) ───────────────────────────────────
# The default AI key every client runs on unless they bring their own. Can now
# also be set from the admin panel (stored in the database); this env value is
# the fallback.
GEMINI_API_KEY=                                   # [required] Google AI Studio key
# Optional: override the model chain without a deploy (comma-separated).
# GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash

# Encryption key for clients' stored AI keys (AES-256-GCM). If unset, the app
# falls back to SUPABASE_SERVICE_KEY. Set a long random string for clarity.
AI_KEY_SECRET=                                    # [optional] recommended

# ── Meta — Facebook & Messenger ─────────────────────────────────────────────
FB_APP_ID=                                        # [required for FB/WA connect]
FB_APP_SECRET=                                    # [required] SECRET
# Some code paths read the FACEBOOK_ prefixed names; set whichever you use.
# FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=                            # [required] webhook verify token you choose
FB_CONFIG_ID=                                     # [optional] Facebook Login config id
WA_CONFIG_ID=                                     # [optional] WhatsApp Embedded Signup config id
WA_LOGIN_CONFIG_ID=                               # [optional] WhatsApp "connect existing" config id

# ── Meta — Instagram (separate app) ─────────────────────────────────────────
IG_APP_ID=                                        # [optional] Instagram app id
IG_APP_SECRET=                                    # [optional] SECRET

# ── Google Calendar (agency bookings) ───────────────────────────────────────
GOOGLE_CLIENT_ID=                                 # [optional]
GOOGLE_CLIENT_SECRET=                             # [optional] SECRET

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=                                   # [optional] SECRET — no emails without it
RESEND_FROM=Autologic <onboarding@resend.dev>     # [optional] verified sender

# ── Payments ────────────────────────────────────────────────────────────────
# Manual bKash / Nagad / Rocket numbers shown to clients on the billing screen.
PAYMENT_BKASH=                                     # [optional]
PAYMENT_NAGAD=                                     # [optional]
PAYMENT_ROCKET=                                    # [optional]
# SSLCommerz card gateway.
SSLCZ_STORE_ID=                                    # [optional]
SSLCZ_STORE_PASSWORD=                              # [optional] SECRET
SSLCZ_MODE=sandbox                                 # [optional] sandbox | live

# ── Security ────────────────────────────────────────────────────────────────
# The super admin's second factor for admin-panel actions. Set a strong value.
ADMIN_PASSWORD=                                    # [required for admin panel] SECRET
# Signs the short-lived OAuth "state" tokens used during channel connect.
OAUTH_STATE_SECRET=                                # [required] SECRET — any long random string
# Locks the daily expiry cron (vercel.json runs /api/cron/expiry at 04:00 UTC).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. Leave it unset and the
# endpoint stays OPEN — it only sends expiry emails, so an unauthenticated call
# cannot do damage, but it can be called repeatedly.
CRON_SECRET=                                       # [optional] SECRET — recommended

# ── Vercel env sync (optional) ──────────────────────────────────────────────
# Only needed if you want the admin panel to ALSO write the AI key into Vercel's
# env. Not needed on a VPS at all. The token grants broad Vercel access — keep
# it secret and scoped as tightly as Vercel allows.
VERCEL_TOKEN=                                      # [optional] SECRET
# Alias accepted if you already have it under this name.
# VERCEL_API_TOKEN=
# Project / team are hardcoded in src/lib/vercel-env.js for this deployment;
# override here only if you fork the project.
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# --- Web Push (phone/browser notifications) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                     # [optional] public VAPID key, safe to expose
VAPID_PRIVATE_KEY=                                # [optional] SECRET — no push without it
VAPID_SUBJECT=mailto:office@autolinium.com        # [optional] contact for the push service

# --- Native push (the installed app, via Firebase Cloud Messaging) ---
FIREBASE_SERVICE_ACCOUNT=                         # [optional] SECRET — the whole Firebase service-account JSON, on one line; no native push without it

# Optional. The dollar-to-taka rate the cost model prints with
# (scripts/ai-cost-model.mjs). Unset, it uses the rate noted in that file; the
# admin panel does not read this — it refreshes its own rate (src/lib/fx.js).
USD_BDT=123.11

# Optional. Days in the month the cost model should assume (28, 30 or 31).
# Only per-day use moves with it — the packages' message allowances are monthly.
DAYS=30
