# Copy this file to .env.local and fill in the real values.
# .env* is gitignored — never commit real keys. This repository is public.

# --- Supabase ---
SUPABASE_URL=https://cchvsgouqqxibhubioch.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://cchvsgouqqxibhubioch.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# --- AI ---
GEMINI_API_KEY=your_gemini_api_key

# --- Meta: Facebook and Messenger ---
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FACEBOOK_VERIFY_TOKEN=your_webhook_verify_token

# --- Meta: Instagram (a separate app, with its own secret) ---
IG_APP_ID=your_instagram_app_id
IG_APP_SECRET=your_instagram_app_secret

# --- Meta: WhatsApp ---
WA_CONFIG_ID=your_whatsapp_config_id

# --- Email ---
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Autologic <onboarding@resend.dev>

# --- Google Calendar ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Payments (SSLCommerz) — not yet configured ---
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_MODE=sandbox

# --- Manual payment fallback ---
PAYMENT_BKASH=
PAYMENT_NAGAD=
PAYMENT_ROCKET=

# --- Misc ---
OAUTH_STATE_SECRET=any_long_random_string
ADMIN_PASSWORD=your_dashboard_password
NEXT_PUBLIC_SITE_URL=https://autologic-chatbot.vercel.app
